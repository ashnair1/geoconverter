# Multi-stage Dockerfile for GDAL compatibility testing
ARG GDAL_VERSION=3.11
FROM ghcr.io/osgeo/gdal:ubuntu-small-${GDAL_VERSION}.0 AS gdal-base

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    python3-venv \
    python3-numpy \
    libz-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy project files
COPY . /workspace/

# Build cesium-terrain-builder
FROM gdal-base AS ctb-builder
WORKDIR /workspace/cesium-terrain-builder

RUN rm -rf build && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -GNinja && \
    ninja

# Test stage
FROM ctb-builder AS tester
WORKDIR /workspace

# Install Python dependencies in a virtual environment with system packages
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install packaging requests numpy

# Create test script
RUN echo '#!/bin/bash\nset -e\n\
echo "=== GDAL Compatibility Test ==="\n\
echo "GDAL Version: $(gdal-config --version)"\n\
echo "Python Version: $(python3 --version)"\n\
echo\n\
echo "Testing cesium-terrain-builder tools..."\n\
cd cesium-terrain-builder/build\n\
./tools/ctb-tile --version\n\
./tools/ctb-info --version\n\
echo "✅ CTB tools working"\n\
echo\n\
echo "Testing geoconverter..."\n\
cd /workspace\n\
python3 -c "import sys; from osgeo import gdal; import numpy as np; print(\"Core dependencies available: GDAL\", gdal.VersionInfo(\"RELEASE_NAME\"), \"NumPy\", np.__version__)"\n\
PYTHONPATH=/workspace python3 -c "from geoconverter.utils import get_dtype, parse_files; print(\"Utils module working\")"\n\
echo "✅ Geoconverter core working"\n\
echo\n\
echo "Creating test data..."\n\
mkdir -p tests\n\
PYTHONPATH=/workspace python3 tests/data.py\n\
echo\n\
echo "Testing conversion functionality..."\n\
python3 -c "\n\
import sys, os\n\
sys.path.append(\"/workspace\")\n\
from osgeo import gdal\n\
import numpy as np\n\
# Test creating a simple raster with GDAL\n\
driver = gdal.GetDriverByName(\"GTiff\")\n\
ds = driver.Create(\"/tmp/test.tif\", 10, 10, 1, gdal.GDT_Byte)\n\
band = ds.GetRasterBand(1)\n\
data = np.ones((10, 10), dtype=np.uint8) * 255\n\
band.WriteArray(data)\n\
ds = None\n\
print(\"✅ GDAL raster creation test passed\")\n\
if os.path.exists(\"/tmp/test.tif\"):\n\
    print(\"✅ Test file created successfully\")\n\
"\n\
echo\n\
echo "🎉 All tests passed for GDAL $(gdal-config --version)"\n\
' > /usr/local/bin/test-compatibility.sh && chmod +x /usr/local/bin/test-compatibility.sh

# Default command
CMD ["test-compatibility.sh"]
