# Multi-stage Dockerfile for GDAL compatibility testing
ARG GDAL_VERSION=3.11
FROM ghcr.io/osgeo/gdal:ubuntu-small-${GDAL_VERSION}.0 as gdal-base

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    python3-numpy \
    libz-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy project files
COPY . /workspace/

# Build cesium-terrain-builder
FROM gdal-base as ctb-builder
WORKDIR /workspace/cesium-terrain-builder

RUN mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -GNinja && \
    ninja

# Test stage
FROM ctb-builder as tester
WORKDIR /workspace

# Install Python dependencies
RUN pip3 install packaging requests

# Create test script
RUN echo '#!/bin/bash\nset -e\n\
echo "=== GDAL Compatibility Test ==="\n\
echo "GDAL Version: $(gdal-config --version)"\n\
echo "Python Version: $(python3 --version)"\n\
echo\n\
echo "Testing cesium-terrain-builder tools..."\n\
cd cesium-terrain-builder/build\n\
./tools/ctb-tile --version\n\
./tools/ctb-info --version\n\
echo "✅ CTB tools working"\n\
echo\n\
echo "Testing geoconverter..."\n\
cd /workspace\n\
python3 -c "from geoconverter import gdal_convert; print(\"Import successful\")"\n\
python3 geoconverter/gdal_convert.py --help > /dev/null\n\
echo "✅ Geoconverter working"\n\
echo\n\
echo "Creating test data..."\n\
python3 tests/data.py\n\
echo\n\
echo "Testing conversion..."\n\
python3 geoconverter/gdal_convert.py -i tests/dummy.tif -o test_output.tif -of GTiff\n\
ls -la test_output.tif\n\
echo "✅ Conversion test passed"\n\
echo\n\
echo "🎉 All tests passed for GDAL $(gdal-config --version)"\n\
' > /usr/local/bin/test-compatibility.sh && chmod +x /usr/local/bin/test-compatibility.sh

# Default command
CMD ["test-compatibility.sh"]
